{
  "name": "epub-tool-newui",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "protocol:generate": "npx --yes @bufbuild/buf@1.72.0 generate && node scripts/normalize_protocol_generated.mjs",
    "protocol:check": "npm run protocol:generate && git diff --exit-code -- frontend/src/generated python_backend/generated",
    "build:verify-ocr-onnx-models": "node scripts/verify_ocr_onnx_models.mjs",
    "build:rust-worker:debug": "cargo build --manifest-path src-tauri/Cargo.toml --bin rust-task-runner",
    "build:rust-worker:release": "cargo build --manifest-path src-tauri/Cargo.toml --release --bin rust-task-runner",
    "dev:bundle-assets": "npm run build:verify-ocr-onnx-models && npm run build:rust-worker:debug",
    "dev:frontend": "npm --prefix frontend run dev -- --host",
    "dev:desktop": "npm run dev:bundle-assets && npm run dev:frontend",
    "dev:mobile": "npm run dev:frontend",
    "build:bundle-assets": "npm run build && npm run build:verify-ocr-onnx-models && npm run build:rust-worker:release",
    "build:mobile-assets": "npm run build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run tauri -- build",
    "tauri:android:init": "npm run tauri -- android init",
    "tauri:android:dev": "npm run tauri -- android dev",
    "tauri:android:build": "npm run tauri -- android build",
    "tauri:ios:init": "npm run tauri -- ios init",
    "tauri:ios:dev": "npm run tauri -- ios dev",
    "tauri:ios:build": "npm run tauri -- ios build",
    "maintenance:fetch-ocr-model": "python scripts/prepare_ocr_models.py",
    "maintenance:convert-ocr-onnx": "python scripts/prepare_ocr_onnx_models.py"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.5"
  }
}
