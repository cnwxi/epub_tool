{
  "name": "epub-tool-newui",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "protocol:generate": "npx --yes @bufbuild/buf@1.72.0 generate && node scripts/normalize_protocol_generated.mjs",
    "protocol:check": "npm run protocol:generate && git diff --exit-code -- frontend/src/generated",
    "build:verify-ocr-model": "cargo run --locked --manifest-path xtask/Cargo.toml -- verify-ocr-model",
    "build:rust-worker:debug": "cargo build --manifest-path src-tauri/Cargo.toml --bin rust-task-runner",
    "build:rust-worker:release": "cargo build --manifest-path src-tauri/Cargo.toml --release --bin rust-task-runner",
    "dev:bundle-assets": "npm run build:verify-ocr-model && npm run build:rust-worker:debug",
    "dev:frontend": "npm --prefix frontend run dev -- --host",
    "dev:desktop": "npm run dev:bundle-assets && npm run dev:frontend",
    "dev:mobile": "npm run dev:frontend",
    "build:bundle-assets": "npm run build && npm run build:verify-ocr-model && npm run build:rust-worker:release",
    "build:mobile-assets": "npm run build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run tauri -- build",
    "tauri:android:init": "npm run tauri -- android init",
    "tauri:android:dev": "cargo run --locked --manifest-path xtask/Cargo.toml -- mobile-dev android",
    "tauri:android:build": "cargo run --locked --manifest-path xtask/Cargo.toml -- mobile-build android",
    "tauri:ios:init": "npm run tauri -- ios init",
    "tauri:ios:dev": "cargo run --locked --manifest-path xtask/Cargo.toml -- mobile-dev ios",
    "tauri:ios:build": "cargo run --locked --manifest-path xtask/Cargo.toml -- mobile-build ios"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.5"
  }
}
