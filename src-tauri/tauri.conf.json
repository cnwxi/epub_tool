{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Epub Tool",
  "identifier": "com.cnwxi.epubtool.newui",
  "version": "26.8.25",
  "build": {
    "beforeDevCommand": { "cwd": "..", "script": "npm run dev:mobile" },
    "beforeBuildCommand": { "cwd": "..", "script": "npm run build:mobile-assets" },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "Epub Tool", "transparent": false, "decorations": true }],
    "security": { "capabilities": ["main-capability"] }
  },
  "bundle": {
    "active": false,
    "resources": {
      "bundle-resources/opencc/*": "opencc/"
    },
    "icon": ["../assets/img/icon.png"]
  }
}
