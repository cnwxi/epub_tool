{
  "build": {
    "beforeDevCommand": {
      "cwd": "..",
      "script": "npm run dev:mobile"
    },
    "beforeBuildCommand": {
      "cwd": "..",
      "script": "npm run build:mobile-assets"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Epub Tool NewUI",
        "transparent": false,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "iOS": {
      "minimumSystemVersion": "15.1"
    },
    "resources": {
      "bundle-resources/ocr-models/PP-OCRv6_small_rec_onnx/*": "ocr-models/PP-OCRv6_small_rec_onnx/",
      "bundle-resources/opencc/*": "opencc/"
    }
  }
}
